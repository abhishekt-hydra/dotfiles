#!/usr/bin/env python3
"""Opaque ~/.secrets backup to Bitwarden; retrieval through fnox.
Never source the file or print secrets, subprocess output, or exception details.
"""
import base64
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'dotfiles/fnox-bitwarden.toml'


def run(args, data=None):
    result = subprocess.run(args, input=data, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, check=False)
    if result.returncode:
        raise RuntimeError('Command failed (output suppressed to protect secrets): ' + args[0])
    return result.stdout


def retrieve():
    encoded = run(['fnox', '--config', str(CONFIG), '--non-interactive',
                   '--no-daemon', 'get', 'DOTFILES_SECRETS_BACKUP'])
    return base64.b64decode(encoded.strip(), validate=True)


def main():
    args = sys.argv[1:]
    if args == ['--help'] or not args:
        print('Usage: script/secrets-bitwarden backup | verify | restore <NEW-FILE>')
        return
    action = args[0]
    if (action in ('backup', 'verify') and len(args) != 1) or (action == 'restore' and len(args) != 2) or action not in ('backup', 'verify', 'restore'):
        raise RuntimeError('Invalid arguments; use --help.')
    if not os.environ.get('BW_SESSION'):
        raise RuntimeError('Unlock Bitwarden in your terminal first: export BW_SESSION="$(bw unlock --raw)"')
    status = json.loads(run(['bw', 'status']))
    if status.get('status') != 'unlocked':
        raise RuntimeError('Bitwarden is not unlocked. Log in and unlock in your terminal.')
    os.umask(0o077)
    if action == 'backup':
        # Treat the complete file as bytes: no parsing, shell evaluation or logging.
        data = (Path.home() / '.secrets').read_bytes()
        item = {'type': 2, 'name': 'dotfiles .secrets backup ' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ'),
                'secureNote': {'type': 0}, 'notes': base64.b64encode(data).decode('ascii')}
        encoded = base64.b64encode(json.dumps(item).encode())
        created = json.loads(run(['bw', 'create', 'item'], encoded))
        item_id = created['id']
        # Only an item reference reaches disk; each backup creates a new vault item.
        import uuid
        item_id = str(uuid.UUID(item_id))
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        if CONFIG.is_symlink():
            raise RuntimeError('Refusing a symlinked fnox config; backup item was created in Bitwarden.')
        contents = ('[providers.bitwarden]\ntype = "bitwarden"\n\n[secrets]\n'
                    'DOTFILES_SECRETS_BACKUP = { provider = "bitwarden", value = "' + item_id + '/notes" }\n')
        temporary = CONFIG.with_name(CONFIG.name + '.tmp-' + str(os.getpid()))
        with temporary.open('x') as file:
            file.write(contents)
        temporary.replace(CONFIG)
        if retrieve() != data:
            raise RuntimeError('Backup created, but fnox round-trip verification failed. Local file unchanged.')
        print('Backup created in Bitwarden and verified byte-for-byte through fnox. Local file unchanged.')
    elif action == 'verify':
        if retrieve() != (Path.home() / '.secrets').read_bytes():
            raise RuntimeError('Backup differs from the local file. No contents displayed.')
        print('Backup matches the local file byte-for-byte.')
    else:
        data = retrieve()
        target = Path(args[1]).expanduser()
        # Exclusive creation prevents overwriting live files or following symlinks.
        with target.open('xb') as file:
            file.write(data)
        print('Restored to the requested new file with owner-only permissions.')


if __name__ == '__main__':
    try:
        main()
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except Exception:
        print('Operation failed; details suppressed to protect secrets. No credentials displayed.', file=sys.stderr)
        sys.exit(1)
