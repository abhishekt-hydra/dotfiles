#!/usr/bin/env bash
# Compatibility entry point: migrate/seed live files and enable mise bootstrap history.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v mise >/dev/null || { echo 'Install mise first: ./script/mise --no-tools' >&2; exit 1; }
command -v python3 >/dev/null || { echo 'Python 3 is required for the one-time dotfiles migration.' >&2; exit 1; }
if ! mise bootstrap dotfiles track --help >/dev/null 2>&1; then
  echo 'mise 2026.9.2 or newer is required. Run: mise self-update --no-plugins' >&2
  exit 1
fi
python3 ./script/seed-dotfiles.py "$@"
mise bootstrap dotfiles save --description 'Migrate/seed dotfiles with mise bootstrap'
mise bootstrap --only dotfiles,services --yes
