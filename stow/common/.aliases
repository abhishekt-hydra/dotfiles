alias c="clear"

# Create a new directory and enter it.
mkcd() {
  mkdir -p "$1"
  cd "$1" || return
}

# Extract various archive formats.
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz)  tar xzf "$1" ;;
      *.bz2)     bunzip2 "$1" ;;
      *.rar)     unrar e "$1" ;;
      *.gz)      gunzip "$1" ;;
      *.tar)     tar xf "$1" ;;
      *.tbz2)    tar xjf "$1" ;;
      *.tgz)     tar xzf "$1" ;;
      *.zip)     unzip "$1" ;;
      *.Z)       uncompress "$1" ;;
      *.7z)      7z x "$1" ;;
      *)         echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Keep private exports/API keys out of git.
[[ -f "$HOME/.secrets" ]] && source "$HOME/.secrets"

# List top files/folders in the current directory.
big() {
  echo "==== Total Directory Size ===="
  du -sh .
  echo ""
  echo "==== Top 20 Biggest Folders ===="
  du -ah . | sort -rh | head -n 20
  echo ""
  echo "==== Top 20 Biggest Files ===="
  find . -type f -exec du -h {} + | sort -rh | head -n 20
}

alias rsync="rsync -Pav"

brewup() {
  local brewup_rc=0

  arch -arm64 /opt/homebrew/bin/brew update && \
    arch -arm64 /opt/homebrew/bin/brew upgrade || brewup_rc=$?

  if command -v claude >/dev/null 2>&1; then
    claude update || brewup_rc=$?
  fi

  mise upgrade github:ogulcancelik/herdr --minimum-release-age 0s || brewup_rc=$?
  prodex update || brewup_rc=$?
  npm install --global @openai/codex@latest || brewup_rc=$?

  return "$brewup_rc"
}

# QMD: force CPU mode to avoid local Metal/node-llama-cpp crashes.
# export QMD_FORCE_CPU=1
# alias qmdmcp="QMD_FORCE_CPU=1 qmd mcp --http --daemon"

# Create a GitHub PR from the current branch to staging.
# Usage: prstaging [custom body]
# Defaults title to the latest commit subject and body to the latest commit message.
prstaging() {
  local branch title body
  branch="$(git branch --show-current)" || return
  if [[ -z "$branch" ]]; then
    echo "prstaging: not on a branch"
    return 1
  fi

  title="$(git log -1 --pretty=%s)" || return
  body="$*"
  if [[ -z "$body" ]]; then
    body="$(git log -1 --pretty=%B)" || return
  fi

  gh auth switch --hostname github.com --user abhishekt-hydra || return
  git push -u origin "$branch" || return
  gh pr create --base staging --head "$branch" --title "$title" --body "$body"
}

alias pr=prstaging
export HOMEBREW_NO_AUTO_UPDATE=1


alias rcpy="rclone copy  -P --transfers 8 "

# Prodex: use real codex binary, not the mise shim (shim resolves to
# ~/.local/bin/mise and fails version check). ~/.local/bin/codex is the
# npm install (0.153.4), stable across mise/node upgrades.
export PRODEX_CODEX_BIN="$HOME/.local/bin/codex"

# oxmgr -- process manager for the local services, replaced PM2 on 2026-07-31.
# It's a *local* npm install under ~/Applications/oxmgr, so its shim is not on
# PATH by default. Appended rather than prepended: this is a node_modules/.bin
# dir, and anything installed there later shouldn't shadow system binaries.
# `typeset -U path PATH` from topics/common/system/path.zsh keeps it deduped.
# Services + rollback notes: ~/Applications/oxmgr/MIGRATION.md
[[ -d "$HOME/Applications/oxmgr/node_modules/.bin" ]] &&
  path+=("$HOME/Applications/oxmgr/node_modules/.bin")
export PATH
