#!/bin/sh
# Jump straight to a Space.
#
# yabai's own `space --focus` is a silent no-op while SIP is enabled (it needs
# the scripting addition), so we drive macOS's native "Switch to Desktop N"
# shortcut instead. Those are bound to hyper + <number> by the dotfiles repo's
# script/macos-space-hotkeys; one keystroke jumps straight to the target, with
# no stepping through the Spaces in between.
set -eu

target=${1:-}
case "$target" in
    [1-9]) ;;
    *)
        echo "usage: focus-space <1-9>" >&2
        exit 2
        ;;
esac

# Key codes for the number row, 1 through 9.
set -- 18 19 20 21 23 22 26 28 25
shift "$((target - 1))"
key_code=$1

exec /usr/bin/osascript -e "tell application \"System Events\" to key code $key_code using {command down, control down, option down, shift down}"
